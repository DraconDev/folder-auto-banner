.BR "f config" .
.TP
.B FAB_NO_TODOS
Set to
.B 1
to disable TODO scanning.
.TP
.B FAB_NO_PORTS
Set to
.B 1
to disable port detection.
.TP
.B FAB_NO_DOCKER
Set to
.B 1
to disable Docker detection.
.TP
.B FAB_NO_METRICS
Set to
.B 1
to disable code metrics.
.TP
.B FAB_PROFILE
Set to
.B 1
to enable IPC profiling output.
.\"
